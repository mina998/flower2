{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "flower2",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "flower2",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "flower2",
		},
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "74c122478b7c4352805b0716757174c2"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": [
			"* * * * *"
		],
	},
}