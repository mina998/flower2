---
import { Image } from "emdash/ui";
import type { Product } from "../../../emdash-env";

interface Props {
	products: { id: string; data: Product }[];
	eyebrow?: string;
	title?: string;
}

const { products, eyebrow = "Some of Our", title = "Recent Product" } = Astro.props;

function getRef(product: Product){
    return product.property?.find((item) => item.name?.trim().toLowerCase() === "ref")?.value?.trim();
}
---

{
	products.length > 0 && (
		<section class="recent">
			<div class="recent-head">
				<span class="recent-eyebrow">{eyebrow}</span>
				<h2 class="recent-title">{title}</h2>
			</div>

			<ul class="recent-grid">
				{products.map((product) => {
					const href = `/product/${product.id}`;
					const ref = getRef(product.data);
					return (
						<li class="product-card">
							<a class="product-media" href={href} tabindex="-1" aria-hidden="true">
								<Image
									image={product.data.featured_image}
									alt={product.data.featured_image?.alt || product.data.title}
									width={480}
									height={600}
									class="product-image"
								/>
							</a>
							<div class="product-info">
								<h3 class="product-title">
									<a href={href}>{product.data.title}</a>
								</h3>
								{ref && <p class="product-ref">Ref: {ref}</p>}
							</div>
						</li>
					);
				})}
			</ul>
		</section>
	)
}

<style>
	.recent-head,
	.recent-grid {
		max-width: var(--content-width);
		margin-inline: auto;
		padding-inline: 10px;
	}

	.recent-head {
		display: flex;
		flex-direction: column;
		padding-block: 60px 30px;
	}

	.recent-eyebrow {
		font-size: 15px;
		line-height: 1;
		color: #4caf50;
	}

	.recent-title {
		margin: 0;
		font-size: 27px;
		line-height: 1.4;
		font-weight: 700;
		color: var(--color-brand);
	}

	.recent-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 20px;
		margin-block: 0;
		list-style: none;
	}

	.product-card {
		display: flex;
		flex-direction: column;
		row-gap: 10px;
		min-width: 0;
		padding: 10px;
		border-radius: 3px;
		background: var(--color-surface);
	}

	.product-media {
		display: block;
		height: 280px;
		overflow: hidden;
	}

	.product-media :global(.product-image) {
		display: block;
		width: 100%;
		max-width: none;
		height: 100%;
		object-fit: cover;
		transition: opacity 0.2s;
	}

	.product-info {
		display: flex;
		flex-direction: column;
		row-gap: 5px;
	}

	.product-ref {
		margin: 0;
		font-size: 14px;
		line-height: 1.7;
	}

	.product-title {
		margin: 0;
		overflow: hidden;
		font-size: 15px;
		line-height: 1.4;
		font-weight: 600;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.product-title a {
		color: #545454;
		text-decoration: none;
		transition: color 0.2s;
	}

	.product-card:hover .product-title a {
		color: var(--color-brand);
	}

	.product-card:hover :global(.product-image) {
		opacity: 0.85;
	}

	@media (max-width: 991px) {
		.recent-grid {
			gap: 10px;
		}
	}

	@media (max-width: 478px) {
		.recent-grid {
			grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
			gap: 5px;
		}

		.product-card {
			padding: 6px;
		}

		.product-media {
			height: 250px;
		}
	}
</style>
