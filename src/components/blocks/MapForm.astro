---
import type {
	HomepageSectionsMapFormBlock,
	PageSectionsMapFormBlock,
} from "../../../emdash-env";

interface Props {
	value?: HomepageSectionsMapFormBlock | PageSectionsMapFormBlock;
	index?: number;
	blockKey?: string;
}

const fallbackAddress = "Room 24d, No38 Linle Road, Tianhe District, Guangzhou, China";
const address = Astro.props.value?.address?.trim() || fallbackAddress;
const buttonLabel = Astro.props.value?.button_label?.trim() || "Send";
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(address)}&z=16&output=embed&hl=en`;
---

<section class="map-form">
	<div class="map">
		<iframe
			title={address}
			src={mapSrc}
			loading="lazy"
			referrerpolicy="no-referrer-when-downgrade"
		></iframe>
	</div>
	<div class="panel">
		<form data-map-form>
			<label>
				<span class="label">Your Name</span>
				<input name="name" type="text" autocomplete="name" required />
			</label>
			<label>
				<span class="label">Your Email</span>
				<input name="email" type="email" autocomplete="email" required />
			</label>
			<label>
				<span class="label">Subject</span>
				<input name="subject" type="text" required />
			</label>
			<label>
				<span class="label">Your Message</span>
				<textarea name="message" rows="5" required></textarea>
			</label>
			<button type="submit">{buttonLabel}</button>
		</form>
		<p class="thanks" data-map-form-thanks hidden tabindex="-1">Thanks. We received your message.</p>
	</div>
</section>

<script>
	for (const form of document.querySelectorAll<HTMLFormElement>("[data-map-form]")) {
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			const thanks = form.parentElement?.querySelector<HTMLElement>("[data-map-form-thanks]");
			form.hidden = true;
			if (!thanks) return;
			thanks.hidden = false;
			thanks.focus();
		});
	}
</script>

<style>
	.map-form {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 20px;
		align-items: stretch;
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 0 10px 64px;
	}

	.map {
		min-height: 420px;
		overflow: hidden;
		border-radius: 4px;
		background: #e7e7e7;
	}

	.map iframe {
		display: block;
		width: 100%;
		height: 100%;
		min-height: 420px;
		border: 0;
	}

	.panel {
		min-width: 0;
		padding: 28px 24px;
		border-radius: 4px;
		background: var(--color-surface);
	}

	.map-form form {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.map-form label {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.label {
		color: var(--color-ink);
		font-size: 15px;
		font-weight: 600;
		line-height: 1.4;
	}

	.map-form input,
	.map-form textarea {
		width: 100%;
		margin: 0;
		padding: 12px 14px;
		border: 1px solid #e6e6e6;
		border-radius: 4px;
		background: var(--color-surface);
		color: var(--color-ink);
		font: inherit;
		font-size: 15px;
		line-height: 1.5;
	}

	.map-form textarea {
		min-height: 140px;
		resize: vertical;
	}

	.map-form input:focus-visible,
	.map-form textarea:focus-visible {
		outline: 2px solid var(--color-brand);
		outline-offset: 1px;
	}

	.map-form button {
		align-self: flex-start;
		margin-top: 4px;
		padding: 12px 36px;
		border: 0;
		border-radius: 4px;
		background: var(--color-brand);
		color: #fff;
		font: inherit;
		font-size: 15px;
		font-weight: 600;
		line-height: 1.4;
		cursor: pointer;
		transition: background-color 0.3s var(--ease-out);
	}

	.map-form button:hover {
		background: #d08b6e;
	}

	.thanks {
		margin: 0;
		color: var(--color-text);
		font-size: 16px;
		line-height: 1.6;
	}

	.thanks:focus {
		outline: none;
	}

	@media (max-width: 767px) {
		.map-form {
			grid-template-columns: 1fr;
			padding-bottom: 48px;
		}

		.map,
		.map iframe {
			min-height: 280px;
		}

		.panel {
			padding: 20px 16px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.map-form button {
			transition: none;
		}
	}
</style>
