---
import type {
	HomepageSectionsNoticeBlock,
	PageSectionsNoticeBlock,
} from "../../../emdash-env";

interface Props {
	value?: HomepageSectionsNoticeBlock | PageSectionsNoticeBlock;
	index?: number;
	blockKey?: string;
}

const title = Astro.props.value?.title?.trim();
const text = Astro.props.value?.text?.trim();
---

{
	(title || text) && (
		<section class="notice">
			{title && <h2>{title}</h2>}
			{text && <p>{text}</p>}
		</section>
	)
}

<style>
	.notice {
		max-width: var(--content-width);
		margin: 24px auto;
		padding: 24px 28px;
		border-left: 4px solid var(--color-brand);
		background: var(--color-surface);
	}

	.notice h2 {
		margin: 0;
		color: var(--color-ink);
		font-size: 24px;
		font-weight: 600;
		line-height: 1.3;
	}

	.notice p {
		margin: 8px 0 0;
		color: var(--color-muted);
		font-size: 16px;
		line-height: 1.7;
	}
</style>
