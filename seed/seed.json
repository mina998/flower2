							"eyebrow": "Service",
							"title": "You Should Choose Us",
							"items": [
								{
									"title": "Certified Experts",
									"text": "Our florists and growers have years of experience drying, preserving and arranging flowers for retailers and events."
								},
								{
									"title": "Quality Services",
									"text": "From our own planting base to the factory floor, every stem is checked before it is packed and shipped to you."
								},
								{
									"title": "Affordable Pricing",
									"text": "Buying direct from the farm keeps costs low, with wholesale prices and a low minimum order for every product."
								}
							]
						},
						{
							"_type": "why_choose_us",
							"_version": 1,
							"_key": "home-why-choose-us",
							"eyebrow": "Why Choose Us for",
							"title": "Why Choose Us for Your Dried Flower Need",
							"reasons": [
								{
									"title": "Wide Range of Products",
									"text": "We are located in Kunming city of China, home to the largest flower wholesale market in Asia. We directly collaborate with planting farms, granting us access to an extensive range of nearly 300 categories of dried plants."
								},
								{
									"title": "Timely Delivery",
									"text": "With ample products in stock and well-equipped facilities, we ensure timely delivery when you place an order with us."
								},
								{
									"title": "Low MOQ",
									"text": "We offer a low MOQ, striving to meet all your needs. Whether for wholesale business or event arrangements, we are dedicated to satisfying your requirements."
